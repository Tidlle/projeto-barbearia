# Banco (docker compose sobe um Postgres local na porta 5433)
DATABASE_URL="postgresql://barber:barber@localhost:5433/barbearia?schema=public"

# Segredo para assinar a sessão do painel (gere um valor aleatório longo)
AUTH_SECRET="troque-por-um-valor-aleatorio"

# URL pública do app (usada nos links de retorno do pagamento)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mercado Pago — deixe vazio para usar o pagamento SIMULADO em desenvolvimento
MERCADOPAGO_ACCESS_TOKEN=""
# Segredo de assinatura dos webhooks (Painel MP > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=""

# Permite o pagamento simulado em produção (NUNCA use "true" com clientes reais)
ALLOW_MOCK_PAYMENTS="false"

# Barbearia dona deste site (slug no banco)
SHOP_SLUG="zer0nze"

# ---- Confirmação de presença pelo WhatsApp (API oficial da Meta) ----
# Sem WHATSAPP_TOKEN/WHATSAPP_PHONE_NUMBER_ID as mensagens ficam em modo SIMULADO (só no painel).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Nome do modelo aprovado na Meta (ver README) e idioma
WHATSAPP_TEMPLATE_CONFIRMACAO="confirmacao_presenca"
WHATSAPP_TEMPLATE_LANG="pt_BR"

# Protege /api/cron/confirmacoes (gere um valor aleatório)
CRON_SECRET="troque-por-um-valor-aleatorio"
# "false" em hospedagem serverless (Vercel); aí use um cron externo chamando a rota acima
INTERNAL_SCHEDULER="true"
